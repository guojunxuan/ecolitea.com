# Database and application security
DATABASE_URI=mongodb://MONGODB_HOST:27017/ecolitea
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET

# Public application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3000
PAYLOAD_PUBLIC_APP_URL=http://localhost:3000
SITEMAP_URL=http://localhost:3000

# Draft preview and content revalidation secrets
NEXT_PRIVATE_DRAFT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
NEXT_PRIVATE_REVALIDATION_KEY=REPLACE_WITH_A_RANDOM_SECRET
REVALIDATION_KEY=REPLACE_WITH_A_RANDOM_SECRET

# Optional modules disabled in the default Ecolitea configuration
NEXT_PUBLIC_ENABLE_CLOUD=false
NEXT_PUBLIC_ENABLE_DOCS=false
NEXT_PUBLIC_ENABLE_COMMUNITY_HELP=false
NEXT_PUBLIC_ENABLE_PARTNERS=false
NEXT_PUBLIC_ENABLE_STYLEGUIDE=false

# Build configuration
NEXT_PUBLIC_SKIP_BUILD_DOCS=true
NEXT_PUBLIC_SKIP_BUILD_HELPS=true

# Analytics
GA_USE_DEMO_DATA=false

# Cloudflare R2 media storage
R2_BUCKET=YOUR_R2_BUCKET
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.YOUR_DOMAIN

# Docker Compose deployment
DOMAIN=YOUR_DOMAIN
ECOLITEA_IMAGE=ghcr.io/GHCR_OWNER/ecolitea
IMAGE_TAG=YOUR_IMAGE_TAG
NEXT_PUBLIC_IS_LIVE=false

# Docker MongoDB authentication (not used by local development)
MONGODB_URI=mongodb://MONGODB_ROOT_USERNAME:URL_ENCODED_MONGODB_ROOT_PASSWORD@mongodb:27017/ecolitea?authSource=admin
MONGO_INITDB_ROOT_USERNAME=YOUR_MONGODB_ROOT_USERNAME
MONGO_INITDB_ROOT_PASSWORD=YOUR_MONGODB_ROOT_PASSWORD

# Optional email, analytics, and form integrations
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID
NEXT_PUBLIC_GTM_MEASUREMENT_ID=YOUR_GTM_MEASUREMENT_ID
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=YOUR_FACEBOOK_PIXEL_ID
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
NEXT_PRIVATE_RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY
NEXT_PRIVATE_HUBSPOT_PORTAL_KEY=YOUR_HUBSPOT_PORTAL_KEY
